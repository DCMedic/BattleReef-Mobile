{
  "expo": {
    "name": "BattleReef",
    "slug": "battlereef-mobile",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "battlereef",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/brand/app-icon.png",
      "bundleIdentifier": "com.battlereef.mobile",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "android": {
      "package": "com.battlereef.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#061522",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundImage": "./assets/brand/adaptive-background.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061522",
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BattleReef to access your photos so you can build your aquarium timeline.",
          "cameraPermission": "Allow BattleReef to use your camera for aquarium photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "battlereef-reminders",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
